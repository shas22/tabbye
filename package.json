{
  "name": "tabbye",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A private, local-first archive for tabs you have stopped using.",
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "tabs",
    "productivity",
    "wxt"
  ],
  "homepage": "https://github.com/OWNER/tabbye#readme",
  "bugs": "https://github.com/OWNER/tabbye/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/tabbye.git"
  },
  "license": "MIT",
  "author": "AUTHOR",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:profile": "bun scripts/build-profile.mjs",
    "benchmark": "bun scripts/benchmark.ts",
    "screenshots": "bun scripts/screenshots.ts",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:protection": "playwright test e2e/tab-protection.spec.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@wxt-dev/module-react": "^1.1.0",
    "eslint": "^10.12.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "jsdom": "^27.1.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0",
    "wxt": "^0.20.0"
  }
}
